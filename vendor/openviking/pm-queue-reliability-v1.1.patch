+    def _record_terminal_semantic_failure(
+        self,
+        msg: SemanticMsg,
+        error: Exception | str,
+        *,
+        reason: str,
+    ) -> None:
+        """Record a bounded retry failure and let NamedQueue ACK the message.
+
+        The original queue item is acknowledged after this handler returns, so
+        an explicit error report is required to avoid silently dropping it while
+        keeping it out of the main semantic queue.
+        """
