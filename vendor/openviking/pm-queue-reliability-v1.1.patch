+            f"dead_letter semantic message ({reason}, "
+            f"retry_count={msg.retry_count}, uri={msg.uri}): {error_text}"
+        )
+        self._merge_request_stats(msg.telemetry_id, error_count=1)
+        if msg.telemetry_id and msg.id:
+            get_request_wait_tracker().mark_semantic_failed(
+                msg.telemetry_id,
+                msg.id,
+                message,
+            )
+        logger.error(message)
+        self.report_error(message, {"data": msg.to_dict()})
 
+    def _prepare_semantic_retry(self, msg: SemanticMsg, error: Exception | str) -> bool:
+        """Increment the durable retry counter or move the item to dead-letter."""
+        if msg.retry_count >= self.max_semantic_retries:
+            self._record_terminal_semantic_failure(
+                msg,
+                error,
+                reason="retry_limit_exceeded",
+            )
+            return False
+        msg.retry_count += 1
+        return True
+
